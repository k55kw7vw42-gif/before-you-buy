# ---------------------------------------------------------------------------
# Before You Pay - environment variables
#
# Copy this file to `.env.local` and fill in ANTHROPIC_API_KEY.
#
# `.env.local` is gitignored. Every value here is read on the server only:
# never add a NEXT_PUBLIC_ prefix to any of them, or Next.js will compile the
# value into the browser bundle and ship your key to every visitor.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------

# API key for the Anthropic vision model, used to read uploaded screenshots.
# Get one at https://platform.claude.com -> API keys.
# Required for real screenshot analysis. Without it the app falls back to the
# offline demo analyser, which cannot read images, and says so in the UI.
ANTHROPIC_API_KEY=sk-ant-...

# Which provider the AI service layer uses.
#   anthropic -> real vision analysis (requires ANTHROPIC_API_KEY)
#   mock      -> offline demo analyser, no network calls, no key needed
# Optional. Defaults to "anthropic" when ANTHROPIC_API_KEY is set, else "mock".
AI_PROVIDER=anthropic

# Vision model id. Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Override the API base URL. Optional, read by the Anthropic SDK itself.
# Leave unset in normal use; `npm run test:vision` sets it to a local stub to
# exercise the vision path without spending credits.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Stripe (subscriptions) ------------------------------------------------
#
# All three are required for payments. Without them the app still runs: the
# Pricing page renders, everyone stays on the Free plan, and the upgrade button
# says payments are not configured.
#
# No publishable key is needed. The app uses hosted Stripe Checkout - the server
# creates the session and returns a URL - so Stripe.js never loads in the
# browser and no Stripe key of any kind reaches the client.

# Secret API key. Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_...

# The recurring Price for Pro ($9.99/month). Create a "Pro" Product with a
# monthly recurring price, then copy its price id (not the product id).
STRIPE_PRICE_ID=price_...

# Signing secret for your webhook endpoint, which must point at
#   POST /api/billing/webhook
# and subscribe to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
# Locally: `stripe listen --forward-to localhost:3000/api/billing/webhook`
# prints a whsec_... to use here.
STRIPE_WEBHOOK_SECRET=whsec_...

# Absolute base URL used to build Checkout return links. Optional - only needed
# behind a proxy that rewrites the host; otherwise the request origin is used.
# APP_URL=https://beforeyoupay.example.com

# Override the Stripe API base URL. Optional, test-only: the billing and
# backfill suites set it to a local stub. Leave unset in every real environment.
# STRIPE_API_BASE=
#
# One-off maintenance: `npm run backfill:periods` populates billing periods for
# subscribers who predate them. It needs only STRIPE_SECRET_KEY and
# DATABASE_PATH, and is a dry run unless given --apply. See the README.

# --- Storage ---------------------------------------------------------------

# Path to the SQLite database file. Created on first run, along with its
# parent directory. Optional. Defaults to ./data/before-you-pay.db
DATABASE_PATH=./data/before-you-pay.db

# --- Rate limiting ---------------------------------------------------------

# Requests allowed per window on the analysis endpoints, per signed-in user or
# per client IP for anonymous visitors. This is abuse protection, separate from
# the plan allowance (3/month Free, 100/billing period Pro). Both optional.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
