# ---------------------------------------------------------------------------
# Before You Pay - environment variables
#
# Copy this file to `.env.local` and fill in ANTHROPIC_API_KEY.
#
# `.env.local` is gitignored. Every value here is read on the server only:
# never add a NEXT_PUBLIC_ prefix to any of them, or Next.js will compile the
# value into the browser bundle and ship your key to every visitor.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------

# API key for the Anthropic vision model, used to read uploaded screenshots.
# Get one at https://platform.claude.com -> API keys.
# Required for real screenshot analysis. Without it the app falls back to the
# offline demo analyser, which cannot read images, and says so in the UI.
ANTHROPIC_API_KEY=sk-ant-...

# Which provider the AI service layer uses.
#   anthropic -> real vision analysis (requires ANTHROPIC_API_KEY)
#   mock      -> offline demo analyser, no network calls, no key needed
# Optional. Defaults to "anthropic" when ANTHROPIC_API_KEY is set, else "mock".
AI_PROVIDER=anthropic

# Vision model id. Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Override the API base URL. Optional, read by the Anthropic SDK itself.
# Leave unset in normal use; `npm run test:vision` sets it to a local stub to
# exercise the vision path without spending credits.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Stripe (subscriptions) ------------------------------------------------
#
# All three are required for payments. Without them the app still runs: the
# Pricing page renders, everyone stays on the Free plan, and the upgrade button
# says payments are not configured.
#
# No publishable key is needed. The app uses hosted Stripe Checkout - the server
# creates the session and returns a URL - so Stripe.js never loads in the
# browser and no Stripe key of any kind reaches the client.

# Secret API key. Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_...

# The recurring Price for Pro ($9.99/month). Create a "Pro" Product with a
# monthly recurring price, then copy its price id (not the product id).
STRIPE_PRICE_ID=price_...

# Signing secret for your webhook endpoint, which must point at
#   POST /api/billing/webhook
# and subscribe to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
# Locally: `stripe listen --forward-to localhost:3000/api/billing/webhook`
# prints a whsec_... to use here.
STRIPE_WEBHOOK_SECRET=whsec_...

# Absolute public base URL of this deployment. REQUIRED in production.
#
# Never derived from the incoming request: behind Render's proxy the request's
# own origin is the container's internal bind address, not a URL anyone outside
# can reach. Used to build the Google OAuth redirect_uri and Stripe's Checkout /
# billing-portal return links - get it wrong and Google's token exchange fails
# with a 400, and Stripe sends people back to the wrong place.
#
# No trailing slash.
NEXTAUTH_URL=https://beforeyoupay.onrender.com

# Old name for the same value, still read if NEXTAUTH_URL is unset. Prefer
# NEXTAUTH_URL in new setups.
# APP_URL=https://beforeyoupay.example.com

# Override the Stripe API base URL. Optional, test-only: the billing and
# backfill suites set it to a local stub. Leave unset in every real environment.
# STRIPE_API_BASE=
#
# One-off maintenance: `npm run backfill:periods` populates billing periods for
# subscribers who predate them. It needs only STRIPE_SECRET_KEY and
# DATABASE_PATH, and is a dry run unless given --apply. See the README.

# --- Sign in with Google (optional) -----------------------------------------
#
# Both are needed for the "Continue with Google" button to appear. Without them
# the app still works; people sign up with an email and password as before.
#
# Create them at https://console.cloud.google.com -> APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application.
#
# The Authorised redirect URI must be exactly:
#   https://your-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# Points the whole OAuth flow at a local stub. Test-only - `npm run test:google`
# sets it. Leave unset in every real environment.
# GOOGLE_OAUTH_BASE=

# --- Storage ---------------------------------------------------------------

# Path to the SQLite database file. Created on first run, along with its
# parent directory. Optional. Defaults to ./data/before-you-pay.db
DATABASE_PATH=./data/before-you-pay.db

# --- Analytics (Google Analytics 4, optional) -------------------------------
#
# Unset by default so local development and the test suite never send real
# hits to a live GA property. Set it to turn tracking on; the app works
# exactly as it does today either way.

# GA4 Measurement id, from Admin -> Data Streams -> your stream, in the GA4
# property. NEXT_PUBLIC_ is intentional here, unlike every other value in
# this file: this id is not a secret - it is visible in every page's network
# requests - and the browser needs it to load gtag.js.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R2YT78S67Q

# --- Ads (Google AdSense, optional) -----------------------------------------
#
# Both are needed for ads to appear. Without them (or with ADS_ENABLED unset),
# no AdSense script loads and no ad unit renders - the app works exactly as
# it does today. Ads only ever show to signed-out visitors and Free-plan
# users; a signed-in Pro subscriber never sees one.

# Master on/off switch. Must be exactly "true" to enable ads.
ADS_ENABLED=false

# AdSense publisher id, from https://www.google.com/adsense -> Account.
# NEXT_PUBLIC_ is intentional here, unlike every other value in this file:
# this id is not a secret - it is visible in the page source of any site
# that runs AdSense - and the ad-unit component needs it in the browser.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-...

# --- Rate limiting ---------------------------------------------------------

# Requests allowed per window on the analysis endpoints, per signed-in user or
# per client IP for anonymous visitors. This is abuse protection, separate from
# the plan allowance (3/month Free, 100/billing period Pro). Both optional.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
